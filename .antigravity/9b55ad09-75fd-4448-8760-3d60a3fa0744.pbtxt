  view_file {
    absolute_path_uri: "file:///src/app/services/ecosystem.service.ts"
    start_line: 99
    end_line: 249
    content: "    heroBannerImage: \'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=1600&q=80\',\n    heroCtaText: \'Explorar Balc\303\265es da Regi\303\243o\',\n    heroAnnouncement: \'\360\237\232\232 Festival Gastron\303\264mico da Paulista: Entregas expressas em at\303\251 30 minutos em todo o per\303\255metro central!\',\n    showHeroAnnouncement: true,\n    featuredTenantIds: [\'tenant-1\', \'tenant-2\', \'tenant-4\'],\n    defaultSearchRadiusKm: 15,\n    activeRegionName: \'Grande S\303\243o Paulo \342\200\242 Polo Central Paulista\'\n  });\n\n  // Global System Health & Infrastructure (Governed by App Owner)\n  readonly uptimePercent = signal<number>(99.99);\n  readonly activeSessionsCount = computed(() => 120 + Math.floor(this.devices().length * 1.5) + (this.orders().length % 20));\n  readonly avgLatencyMs = computed(() => Math.round(10 + (this.activeSessionsCount() / 50)));\n  readonly maintenanceMode = signal<boolean>(false);\n  readonly globalBroadcastMessage = signal<string | null>(null);\n\n  // Final Audit Verification State\n  readonly systemAuditVerified = signal<boolean>(false);\n\n  verifyFullSystemAudit() {\n    this.systemAuditVerified.set(true);\n    this.logAudit(\'Auditoria Geral Conclu\303\255da\', \'HQ\', \'O ecossistema foi inspecionado em todas as esferas (HQ, OS, Marketplace). Integridade confirmada.\', \'info\');\n    this.notify(\'Auditoria Geral do Ecossistema conclu\303\255da com sucesso!\', \'success\');\n  }\n\n  updateRegionalConfig(updates: Partial<RegionalMarketplaceConfig>) {\n    this.regionalConfig.update(cfg => ({ ...cfg, ...updates }));\n    this.notify(\'Portal Regional atualizado pelo Gabinete Executivo HQ com sucesso!\', \'success\');\n  }\n\n  // Haversine geodesic distance in kilometers\n  calculateDistanceToUser(destLat?: number, destLng?: number): number {\n    if (!destLat || !destLng) return 1.2;\n    const user = this.userReferenceCoords();\n    return this.mapTools.calculateDistance(user, { lat: destLat, lng: destLng }).km;\n  }\n\n  // Tenants (HQ & Regional Directory)\n  readonly tenants = signal<CompanyTenant[]>([\n    {\n      id: \'tenant-1\',\n      name: \'Burger & Co Gourmet\',\n      legalName: \'Burger & Co Gastronomia Artesanal S.A.\',\n      cnpj: \'14.882.910/0001-44\',\n      category: \'restaurant\',\n      plan: \'Professional\',\n      status: \'active\',\n      devicesLimit: 6,\n      activeDevicesCount: 4,\n      contactEmail: \'gerencia@burgerco.com.br\',\n      phone: \'+55 11 3254-8899\',\n      createdAt: \'2024-11-20\',\n      address: {\n        street: \'Rua Augusta\',\n        number: \'1500\',\n        neighborhood: \'Consola\303\247\303\243o\',\n        city: \'S\303\243o Paulo\',\n        state: \'SP\',\n        zipCode: \'01304-001\',\n        complement: \'Sal\303\243o T\303\251rreo e Balc\303\243o\'\n      },\n      deliveryRadiusKm: 8,\n      serviceFeePercent: 10,\n      openingHours: \'Ter\303\247a a Domingo, das 11:30 \303\240s 23:45\',\n      fichaCode: \'#001\',\n      lat: -23.5578,\n      lng: -46.6599,\n      rating: 4.9,\n      reviewCount: 238,\n      tagline: \'Alimentos & Bebidas \342\200\242 Hamburgueria Artesanal & Chopps\',\n      badgeCategory: \'RESTAURANTES\',\n      supportsDelivery: true,\n      supportsTakeout: true,\n      supportsReservation: true,\n      isOpen: true,\n      estimatedDeliveryMinutes: \'30-45 min\',\n      deliveryFee: 5.0,\n      logo: \'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=200&q=80\',\n      specialties: [\'Smash Burgers\', \'Queijo Brie Trufado\', \'Batata R\303\272stica\', \'Craft Beers\'],\n      storeSlug: \'burger-co\',\n      themeColor: \'amber\',\n      announcementText: \'\360\237\224\245 Especial de Quarta: Combo Burger Artisan + Chopp com 20% OFF!\',\n      showAnnouncement: true,\n      announcementType: \'promo\',\n      whatsappNumber: \'+55 11 98765-4321\',\n      instagramHandle: \'@burgercogourmet\',\n      aboutText: \'Hamburgueria artesanal de alta gastronomia com cortes nobres selecionados, p\303\243es de fermenta\303\247\303\243o natural e chopps artesanais locais.\',\n      highlightedProductIds: [\'prod-1\', \'prod-3\'],\n      minOrderValue: 25.00,\n      deliveryFleetType: \'platform\',\n      driverRateConfig: {\n        baseFee: 7.00,\n        includedKm: 3.0,\n        extraKmFee: 1.50,\n        extraStopBonus: 3.00\n      }\n    },\n    {\n      id: \'tenant-2\',\n      name: \'Padaria & Emp\303\263rio Estrela\',\n      legalName: \'Estrela Bela Vista Panifica\303\247\303\243o e Emp\303\263rio Ltda\',\n      cnpj: \'28.199.412/0001-89\',\n      category: \'retail\',\n      plan: \'Enterprise\',\n      status: \'active\',\n      devicesLimit: 8,\n      activeDevicesCount: 5,\n      contactEmail: \'pedidos@padariaestrela.com.br\',\n      phone: \'+55 11 3105-1222\',\n      createdAt: \'2024-08-14\',\n      address: {\n        street: \'Alameda Joaquim Eug\303\252nio de Lima\',\n        number: \'680\',\n        neighborhood: \'Jardins\',\n        city: \'S\303\243o Paulo\',\n        state: \'SP\',\n        zipCode: \'01403-000\',\n        complement: \'Esquina c/ Alameda Santos\'\n      },\n      deliveryRadiusKm: 12,\n      serviceFeePercent: 8,\n      openingHours: \'Todos os dias, das 06:00 \303\240s 22:30\',\n      fichaCode: \'#002\',\n      lat: -23.5684,\n      lng: -46.6492,\n      rating: 4.8,\n      reviewCount: 312,\n      tagline: \'Varejo & Padaria \342\200\242 Fermenta\303\247\303\243o Natural, Frios & Caf\303\251s Especiais\',\n      badgeCategory: \'VAREJO\',\n      supportsDelivery: true,\n      supportsTakeout: true,\n      supportsReservation: false,\n      isOpen: true,\n      estimatedDeliveryMinutes: \'25-40 min\',\n      deliveryFee: 4.5,\n      logo: \'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=200&q=80\',\n      coverImage: \'https://images.unsplash.com/photo-1549931319-a545dcf3bc73?auto=fo
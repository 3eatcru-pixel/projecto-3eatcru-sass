  view_file {
    absolute_path_uri: "file:///src/app/components/hq/hq-documentation-modal.ts"
    start_line: 99
    end_line: 199
    content: "                    <div class=\"flex items-center gap-2 text-rose-900 font-serif font-black uppercase text-xs\">\n                      <mat-icon class=\"text-rose-700\">admin_panel_settings</mat-icon>\n                      <span>1. HQ Central (Dono)</span>\n                    </div>\n                    <p class=\"text-stone-600 text-[11px] leading-snug\">\n                      Painel do propriet\303\241rio da plataforma SaaS. Controla contratos, provisiona filiais, ret\303\251m o split de 8%, gerencia os 4 APKs Android e monitora a infraestrutura.\n                    </p>\n                  </div>\n\n                  <div class=\"bg-white p-4 rounded-2xl border border-[#e8dfce] space-y-2 shadow-sm\">\n                    <div class=\"flex items-center gap-2 text-amber-900 font-serif font-black uppercase text-xs\">\n                      <mat-icon class=\"text-amber-700\">storefront</mat-icon>\n                      <span>2. Client OS (Lojista)</span>\n                    </div>\n                    <p class=\"text-stone-600 text-[11px] leading-snug\">\n                      Sistema operacional comercial da loja. Frente de caixa (PDV), comanda de sal\303\243o, KDS da cozinha, gest\303\243o de estoque ERP e livro-caixa local.\n                    </p>\n                  </div>\n\n                  <div class=\"bg-white p-4 rounded-2xl border border-[#e8dfce] space-y-2 shadow-sm\">\n                    <div class=\"flex items-center gap-2 text-emerald-900 font-serif font-black uppercase text-xs\">\n                      <mat-icon class=\"text-emerald-700\">public</mat-icon>\n                      <span>3. Consumidor (P\303\272blico)</span>\n                    </div>\n                    <p class=\"text-stone-600 text-[11px] leading-snug\">\n                      Marketplace Regional (/regional) com busca geod\303\251sica GPS e Vitrine P\303\272blica da Loja (/p/:id) para pedidos online e agendamento.\n                    </p>\n                  </div>\n                </div>\n              </div>\n            }\n\n            @case (\'modules\') {\n              <div class=\"space-y-3\">\n                <div class=\"bg-white p-4 rounded-2xl border border-[#e8dfce] space-y-2\">\n                  <h4 class=\"font-serif font-black text-amber-950 uppercase text-xs\">M\303\263dulos Principais do Master Tower</h4>\n                  <ul class=\"list-disc pl-5 space-y-1.5 text-stone-700\">\n                    <li><strong>Portf\303\263lio de Lojas:</strong> Provisionamento on-demand de unidades com escolha de plano, CNPJ e contrato de comiss\303\243o.</li>\n                    <li><strong>Frota MDM &amp; Dispositivos:</strong> Pareamento de terminais POS touch com comando de rein\303\255cio/bloqueio remoto e ping geod\303\251sico GPS para entregadores.</li>\n                    <li><strong>Console de Auditoria Mobile (APKs):</strong> Emulador em tempo real dos 4 aplicativos Android nativos.</li>\n                    <li><strong>Tesouraria &amp; Split (8%):</strong> Contabilidade em tempo real do GMV e c\303\241lculo de repasse l\303\255quido para as lojas.</li>\n                    <li><strong>Portal Regional:</strong> Gerenciamento da capa do Marketplace, an\303\272ncio de destaque com selo <span class=\"font-mono font-bold text-amber-900\">\360\237\217\206 NO CENTRAL</span> e raio de busca.</li>\n                    <li><strong>Infraestrutura &amp; Audit Trail:</strong> Monitoramento de throughput do banco de dados, broadcast global e trilha fiscal de auditoria.</li>\n                  </ul>\n                </div>\n              </div>\n            }\n\n            @case (\'delivery\') {\n              <div class=\"space-y-3\">\n                <div class=\"bg-amber-50 p-4 rounded-2xl border border-amber-200 space-y-2\">\n                  <h4 class=\"font-serif font-black text-amber-950 uppercase text-xs\">Regras de Entrega (Lojista Decide)</h4>\n                  <p class=\"text-stone-700 leading-relaxed\">\n                    Cada lojista credenciado no ecossistema possui autonomia no Client OS para parametrizar suas regras de log\303\255stica:\n                  </p>\n                </div>\n\n                <div class=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n                  <div class=\"bg-white p-3.5 rounded-2xl border border-[#e8dfce] space-y-1\">\n                    <div class=\"font-bold text-stone-900\">1. Pedido M\303\255nimo (R$)</div>\n                    <p class=\"text-stone-600 text-[11px]\">\n                      Valor m\303\255nimo em produtos necess\303\241rio para aceitar entrega (ex: R$ 25,00). O checkout valida e bloqueia compras abaixo do m\303\255nimo.\n                    </p>\n                  </div>\n\n                  <div class=\"bg-white p-3.5 rounded-2xl border border-[#e8dfce] space-y-1\">\n                    <div class=\"font-bold text-stone-900\">2. Taxa de Delivery (R$)</div>\n                    <p class=\"text-stone-600 text-[11px]\">\n                      Valor cobrado do cliente pela entrega (ex: R$ 5,00 ou R$ 0,00 para Entrega Gr\303\241tis).\n                    </p>\n                  </div>\n\n                  <div class=\"bg-white p-3.5 rounded-2xl border border-[#e8dfce] space-y-1\">\n                    <div class=\"font-bold text-stone-900\">3. Opera\303\247\303\243o de Frota</div>\n                    <p class=\"text-stone-600 text-[11px]\">\n                      Escolha entre \360\237\233\265 <strong>Frota Pr\303\263pria da Loja</strong> (motoboys internos) ou \342\232\241 <strong>Frota Parceira 3EAT</strong> (despacho via App do Motorista).\n                    </p>\n                  </div>\n                </div>\n              </div>\n            }\n\n            @case (\'permissions\') {\n              <div class=\"space-y-3\">\n                <div class=\"bg-white p-4 rounded-2xl border border-[#e8dfce] overflow-x-auto\">\n                  <table class=\"w-full text-left text-xs border-collapse\">\n                    <thead>\n                      <tr class=\"border-b border-stone-200 font-mono font-bold text-stone-500 uppercase text-[10px]\">\n                        <th class=\"py-2 px-3\">PERFIL</th>\n                        <th class=\"py-2 px-3\">ROTA</th>\n                        <th class=\"py-2 px-3\">ESCOPO DE PERMISS\303\203O</th>\n                      </tr>\n                    </thead>\n                    <tbody class=\"divide-y divide-stone-100 font-mono\">\n                      <tr>\n                        <td class=\"py-2 px-3 font-bold text-rose-900\">Dono do App (HQ)</td>\n                        <td class=\"py-2 px-3 text-stone-600\">/hq</td>\n                        <td class=\"py-2 px-3 text-stone-800 font-sans\">Acesso total irrestrito: governan\303\247a, comiss\303\265es, MDM e infraestrutura.</td>\n                      </tr>\n                      <tr>\n                        <td class=\"py-2 px-3 font-bold text-amber-900\">Lojista (Empresa)</td>"
    num_lines: 240
    num_bytes: 13361
    line_range_bytes: 6597
  }
}

e5c6220/implementation_plan.md.metadata.json ---\n```json\n{\n  \"summary\":  \"Implementation plan for the HQ Pro Driver Management and Automatic 3-Order Route Dispatcher dashboard with architecture document.\",\n  \"updatedAt\":  \"2026-10-28T19:49:20.487900767Z\",\n  \"requestFeedback\":  true,\n  \"userFacing\":  true\n}\n```\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /angular.json ---\n```json\n{\n  \"$schema\": \"./node_modules/@angular/cli/lib/config/schema.json\",\n  \"version\": 1,\n  \"cli\": {\n    \"packageManager\": \"npm\",\n    \"schematicCollections\": [\n      \"angular-eslint\"\n    ]\n  },\n  \"newProjectRoot\": \"projects\",\n  \"projects\": {\n    \"app\": {\n      \"projectType\": \"application\",\n      \"schematics\": {},\n      \"root\": \"\",\n      \"sourceRoot\": \"src\",\n      \"prefix\": \"app\",\n      \"architect\": {\n        \"build\": {\n          \"builder\": \"@angular/build:application\",\n          \"options\": {\n            \"browser\": \"src/main.ts\",\n            \"tsConfig\": \"tsconfig.app.json\",\n            \"assets\": [\n              {\n                \"glob\": \"**/*\",\n                \"input\": \"public\"\n              }\n            ],\n            \"styles\": [\n              \"src/styles.css\"\n            ],\n            \"server\": \"src/main.server.ts\",\n            \"outputMode\": \"server\",\n            \"ssr\": {\n              \"entry\": \"src/server.ts\"\n            }\n          },\n          \"configurations\": {\n            \"production\": {\n              \"budgets\": [\n                {\n                  \"type\": \"initial\",\n                  \"maximumWarning\": \"1.5MB\",\n                  \"maximumError\": \"2.5MB\"\n                },\n                {\n                  \"type\": \"anyComponentStyle\",\n                  \"maximumWarning\": \"4kB\",\n                  \"maximumError\": \"8kB\"\n                }\n              ],\n              \"outputHashing\": \"all\"\n            },\n            \"development\": {\n              \"optimization\": false,\n              \"extractLicenses\": false,\n              \"sourceMap\": true\n            }\n          },\n          \"defaultConfiguration\": \"production\"\n        },\n        \"serve\": {\n          \"builder\": \"@angular/build:dev-server\",\n          \"configurations\": {\n            \"production\": {\n              \"buildTarget\": \"app:build:production\"\n            },\n            \"development\": {\n              \"buildTarget\": \"app:build:development\"\n            }\n          },\n          \"defaultConfiguration\": \"development\"\n        },\n        \"test\": {\n          \"builder\": \"@angular/build:unit-test\"\n        },\n        \"lint\": {\n          \"builder\": \"@angular-eslint/builder:lint\",\n          \"options\": {\n            \"lintFilePatterns\": [\n              \"src/**/*.ts\",\n              \"src/**/*.html\"\n            ]\n          }\n        }\n      }\n    }\n  }\n}\n\n```\n\n--- /firebase-applet-config.json ---\n```json\n{\n  \"projectId\": \"coastal-moonlight-rjkjx\",\n  \"appId\": \"1:37763720611:web:7fb3af17c705191ce22616\",\n  \"apiKey\": \"AIzaSyCFDGaBg1z8Sfg2-i71xNnVXG2ELYRALOc\",\n  \"authDomain\": \"coastal-moonlight-rjkjx.firebaseapp.com\",\n  \"firestoreDatabaseId\": \"ai-studio-3eatcruerppos-9b55ad09-75fd-4448-8760-3d60a3fa0744\",\n  \"storageBucket\": \"coastal-moonlight-rjkjx.firebasestorage.app\",\n  \"messagingSenderId\": \"37763720611\",\n  \"measurementId\": \"\",\n  \"oAuthClientId\": \"37763720611-gvuun5q158s0nk21i286j69me8gb1rq4.apps.googleusercontent.com\",\n  \"recaptchaSiteKey\": \"\"\n}\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"3EATCRU - ERP \\u0026 POS\",\n  \"description\": \"High-fidelity, zoneless Operating System for Gastronomy and Retail, featuring ultra-fast POS, real-time KDS, Inventory ERP, Service Orders, and deep Analytics.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/app/app.ts ---\n```typescript\nimport { ChangeDetectionStrategy, Component, inject, signal, computed } from \'@angular/core\';\nimport { CommonModule } from \'@angular/common\';\nimport { MatIconModule } from \'@angular/material/icon\';\nimport { RouterModule, Router } from \'@angular/router\';\nimport { EcosystemService } from \'./services/ecosystem.service\';\n\nimport { EcosystemSwitcherComponent } from \'./components/shared/ecosystem-switcher\';\nimport { NotificationToastComponent } from \'./components/shared/notification-toast\';\n\n@Component({\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  selector: \'app-root\',\n  standalone: true,\n  imports: [\n    CommonModule,\n    MatIconModule,\n    RouterModule,\n    EcosystemSwitcherComponent,\n    NotificationToastComponent\n  ],\n  templateUrl: \'./app.html\',\n  styleUrl: \'./app.css\',\n})\nexport class App {\n  readonly ecosystem = inject(EcosystemService);\n  private readonly router = inject(Router);\n\n  readonly showEcosystemSwitcher = signal<boolean>(false);\n  \n  // Explicitly ensuring isHqAdmin is a computed signal\n  readonly isHqAdmin = computed(() => {\n    const session = this.ecosystem.currentSession();\n    return session && session.role === \'hq_admin\';\n  });\n\n  toggleSwitcher() {\n    if (!this.isHqAdmin()) {\n      this.ecosystem.notify(\'Acesso restrito ao Administrador HQ Central.\', \'warning\');\n      return;\n    }\n    this.showEcosystemSwitcher.update(v => !v);\n  }\n\n  navigateTo(path: string) {\n    if (!this.isHqAdmin() && path === \'/hq\') {\n      this.ecosystem.notify(\'Acesso restrito ao Dono do App.\', \'warning\');\n      return;\n    }\n    this.router.navigate([path]);\n    this.showEcosystemSwitcher.set(false);\n  }\n}\n\n```\n\n--- /src/app/components/driver-app.ts ---\n```typescript\n/* eslint-disable @typescript-eslint/no-explicit-any */\nimport { ChangeDetectionStrategy, Component, inject, signal, computed, ElementRef, viewChild, afterNextRender } from \'@angular/core\';\nimport { CommonModule } from \'@angular/common\';\nimport { MatIconModule } from \'@angular/material/icon\';\nimport { Router } from \'@angular/router\';\nimport { EcosystemService } from \'../services/ecosystem.service\';\nimport { DeliveryRoute, DeliveryWaypoint } from \'../models/ecosystem.model\';\n\ntype DriverScreenTab = \'active_route\' | \'available_routes\' | \'delivery_details\' | \'financial\' | \'profile\' | \'proof_summary\';\n\n@Component({\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  selector: \'app-driver-app\',\n  imports: [CommonModule, MatIconModule],\n  template: `\n    <div class=\"min-h-screen bg-[#070110] text-slate-100 font-sans selection:bg-purple-600 selection:text-white relative overflow-hidden\">\n      \n      <!-- NEON DECORATION -->\n      <div class=\"absolute -top-24 -left-24 w-96 h-96 bg-purple-600/20 blur-[120px] rounded-full pointer-events-none\"></div>\n      <div class=\"absolute -bottom-24 -right-24 w-96 h-96 bg-magenta-600/10 blur-[120px] rounded-full pointer-events-none\"></div>\n\n      <div class=\"max-w-md md:max-w-5xl mx-auto min-h-screen flex flex-col relative z-10 shadow-[0_0_100px_rgba(168,85,247,0.1)] border-x border-white/5 bg-[#070110]\">\n        \n        <!-- TOP STATUS BAR (MOBILE NATIVE PREVIEW) -->\n        <div class=\"flex justify-between items-center px-6 py-4 text-[11px] font-bold text-slate-400\">\n          <span>{{ currentTime() }}</span>\n          <div class=\"flex items-center gap-1.5\">\n            <mat-icon class=\"text-[14px] w-4 h-4\">signal_cellular_4_bar</mat-icon>\n            <mat-icon class=\"text-[14px] w-4 h-4\">wifi</mat-icon>\n            <mat-icon class=\"text-[14px] w-4 h-4\">battery_full</mat-icon>\n          </div>\n        </div>\n\n        <!-- HEADER / NAVIGATION -->\n        <div class=\"px-6 pb-4\">\n          <div class=\"flex items-center justify-between\">\n            <div class=\"flex items-center gap-3\">\n               @if (activeTab() !== \'active_route\' && activeTab() !== \'available_routes\' && activeTab() !== \'financial\' && activeTab() !== \'profile\') {\n                 <button (click)=\"goBack()\" class=\"p-2 -ml-2 text-slate-400 hover:text-white transition-colors cursor-pointer\">\n                   <mat-icon>arrow_back</mat-icon>\n                 </button>\n               } @else {\n                 <div class=\"w-10 h-10 rounded-2xl bg-purple-600 flex items-center justify-center shadow-[0_0_20px_rgba(168,85,247,0.4)]\">\n                   <mat-icon class=\"text-white\">two_wheeler</mat-icon>\n                 </div>\n               }\n               <div>\n                 <h1 class=\"text-lg font-black tracking-tight text-white flex items-center gap-1\">\n                   <span>3eat</span>\n                   <span class=\"text-purple-500 italic\">Entregas</span>\n                 </h1>\n               </div>\n            </div>\n            \n            <button (click)=\"goToOSWorkstation()\" class=\"p-2 rounded-xl bg-white/5 border border-white/10 text-slate-400 hover:text-white transition-all cursor-pointer\">\n              <mat-icon class=\"text-lg\">desktop_windows</mat-icon>\n            </button>\n          </div>\n        </div>\n\n        <!-- MAIN CONTENT AREA -->\n        <div class=\"flex-1 overflow-y-auto custom-scrollbar px-6 pb-24\">\n          \n          <!-- SCREEN 1: ACTIVE ROUTE / MAP -->\n          @if (activeDriverProfile()?.status === \'offline\') {\n            <div class=\"flex flex-col items-center justify-center py-20 text-center animate-in zoom-in duration-500\">\n               <div class=\"w-24 h-24 rounded-[2rem] bg-purple-600/10 border border-purple-500/30 flex items-center justify-center text-purple-500 mb-6 shadow-[0_0_40px_rgba(168,85,247,0.15)] relative overflow-hidden group\">\n                  <div class=\"absolute inset-0 bg-purple-500/5 animate-pulse\"></div>\n                  <mat-icon class=\"text-6xl z-10 group-hover:scale-110 transition-transform\">qr_code_2</mat-icon>\n               </div>\n               <h3 class=\"text-xl font-black text-white uppercase tracking-tight mb-2\">Entrada Obrigat\303\263ria</h3>\n               <p class=\"text-[10px] text-slate-500 uppercase tracking-widest max-w-xs mx-auto mb-10 leading-relaxed\">\n                 Voc\303\252 est\303\241 offline. Para come\303\247ar a receber rotas, realize o <strong>Clock-in</strong> escaneando o c\303\263digo de entrada na loja.\n               </p>\n               \n               <button (click)=\"openShiftScanModal()\" class=\"w-full py-5 bg-purple-600 hover:bg-purple-500 text-white font-black text-xs uppercase tracking-[0.2em] rounded-2xl shadow-[0_10px_30px_rgba(168,85,247,0.3)] transition-all active:scale-95 cursor-pointer flex items-center justify-center gap-3\">\n                  <mat-icon>qr_code_scanner</mat-icon>\n                  Escanear Entrada (Clock-in)\n               </button>\n            </div>\n          } @else if (activeTab() === \'active_route\') {\n            @if (currentActiveRoute(); as route) {\n              <div class=\"space-y-6 animate-in fade-in duration-500\">\n                <!-- Status & Route Code -->\n                <div class=\"flex items-center justify-between bg-white/5 border border-white/10 rounded-3xl p-4\">\n                   <div class=\"flex items-center gap-3\">\n                      @if (route.status === \'at_store\') {\n                        <div class=\"w-2 h-2 rounded-full bg-amber-500 animate-pulse shadow-[0_0_8px_rgba(245,158,11,0.5)]\"></div>\n                        <span class=\"text-[10px] font-black uppercase text-amber-500 tracking-widest\">Na Loja (Coleta)</span>\n                      } @else if (route.status === \'accepted\') {\n                        <div class=\"w-2 h-2 rounded-full bg-indigo-500 animate-pulse shadow-[0_0_8px_rgba(99,102,241,0.5)]\"></div>\n                        <span class=\"text-[10px] font-black uppercase text-indigo-500 tracking-widest\">Ido para a Loja</span>\n                      } @else {\n                        <div class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse shadow-[0_0_8px_rgba(16,185,129,0.5)]\"></div>\n                        <span class=\"text-[10px] font-black uppercase text-emerald-500 tracking-widest\">Em Rota</span>\n                      }\n                      <span class=\"text-sm font-black text-white uppercase\">{{ route.routeCode }}</span>\n                   </div>\n                   <span class=\"text-[10px] font-black text-slate-500 uppercase\">{{ completedWaypointsCount(route) }}/{{ route.waypoints.length }} Entregas</span>\n                </div>\n\n                <!-- FLOW CONTROL BUTTONS (PICKUP) -->\n                @if (route.status === \'at_store\') {\n                  <div class=\"bg-purple-950/20 border border-purple-500/30 rounded-3xl p-6 text-center space-y-4 animate-in slide-in-from-top duration-300\">\n                    <div class=\"flex flex-col items-center gap-2\">\n                       <mat-icon class=\"text-4xl text-purple-400\">inventory_2</mat-icon>\n                       <h4 class=\"text-sm font-black text-white uppercase\">Aguardando Coleta dos Pedidos</h4>\n                       <p class=\"text-[10px] text-slate-400 uppercase tracking-widest\">A loja est\303\241 preparando os pacotes desta rota.</p>\n                    </div>\n\n                    <button (click)=\"confirmPickup(route.id)\" class=\"w-full py-4 bg-emerald-600 hover:bg-emerald-500 text-white font-black text-xs uppercase tracking-[0.2em] rounded-2xl shadow-lg transition-all flex items-center justify-center gap-2 cursor-pointer\">\n                      <mat-icon>check_circle</mat-icon>\n                      Confirmar Coleta dos Pedidos\n                    </button>\n                  </div>\n                }\n\n                <!-- Next Stop Card -->\n                @if (nextWaypoint(route); as wp) {\n                  <button (click)=\"selectWaypoint(wp)\" class=\"w-full text-left bg-white/5 border border-white/10 rounded-3xl p-5 group hover:bg-white/10 transition-all cursor-pointer relative overflow-hidden\">\n                    <div class=\"absolute top-0 right-0 p-3\">\n                      <mat-icon class=\"text-slate-600 group-hover:text-purple-500 transition-colors\">chevron_right</mat-icon>\n                    </div>\n                    <div class=\"flex items-start gap-4\">\n                      <div class=\"w-10 h-10 rounded-2xl bg-purple-600 text-white flex items-center justify-center font-black text-lg shadow-[0_0_15px_rgba(168,85,247,0.3)]\">\n                        {{ wp.sequenceNumber }}\n                      </div>\n                      <div class=\"flex-1 min-w-0\">\n                        <span class=\"text-[9px] font-black text-purple-400 uppercase tracking-widest block mb-1\">Pr\303\263xima Parada</span>\n                        <h4 class=\"text-sm font-black text-white uppercase truncate\">{{ wp.customerName }}</h4>\n                        <div class=\"flex items-center gap-1.5 mt-1 text-slate-400\">\n                          <mat-icon class=\"text-xs\">place</mat-icon>\n                          <span class=\"text-[10px] font-bold truncate\">{{ wp.address }}</span>\n                        </div>\n                        <div class=\"flex items-center gap-4 mt-3\">\n                          <div class=\"flex items-center gap-1\">\n                            <mat-icon class=\"text-[10px] text-slate-500\">near_me</mat-icon>\n                            <span class=\"text-[10px] font-black text-slate-300 uppercase\">{{ wp.distanceKm }} km</span>\n                          </div>\n                          <div class=\"flex items-center gap-1\">\n                            <mat-icon class=\"text-[10px] text-slate-500\">schedule</mat-icon>\n                            <span class=\"text-[10px] font-black text-slate-300 uppercase\">{{ wp.etaMinutes }} min</span>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </button>\n                }\n\n                <!-- Real Map Container -->\n                <div class=\"relative h-[320px] rounded-[2.5rem] border border-white/10 overflow-hidden shadow-2xl bg-slate-900 group\">\n                   <div #mapContainer class=\"w-full h-full grayscale-[0.8] contrast-[1.2] invert-[0.9] hue-rotate-[180deg]\"></div>\n                   \n                   <!-- GPS Info Overlay -->\n                   <div class=\"absolute top-4 left-4 z-[1000] bg-slate-950/80 backdrop-blur-md border border-white/10 px-3 py-1.5 rounded-xl flex items-center gap-2\">\n                      <div class=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\"></div>\n                      <span class=\"text-[9px] font-black uppercase text-white tracking-widest\">GPS Geod\303\251sico Ativo</span>\n                   </div>\n\n                   <!-- Geodetic Navigation Controls -->\n                   <div class=\"absolute bottom-4 left-4 z-[1000] flex gap-2\">\n                      @if (route.status === \'in_progress\') {\n                        <button (click)=\"toggleGpsNavigation()\" class=\"px-3 py-2 rounded-xl bg-purple-600 text-white text-[9px] font-black uppercase tracking-widest shadow-lg hover:bg-purple-500 transition-all cursor-pointer\">\n                          {{ isGpsActive() ? \'\342\217\270\357\270\217 Pausar GPS\' : \'\342\226\266\357\270\217 Iniciar Navega\303\247\303\243o GPS\' }}\n                        </button>\n                      } @else if (route.status === \'accepted\') {\n                        <button (click)=\"arriveAtStore(route.id)\" class=\"px-3 py-2 rounded-xl bg-amber-600 text-white text-[9px] font-black uppercase tracking-widest shadow-lg hover:bg-amber-500 transition-all cursor-pointer\">\n                          \360\237\223\215 J\303\241 cheguei na Loja\n                        </button>\n                      }\n                   </div>\n                </div>\n\n                <!-- Bottom Stats -->\n                <div class=\"grid grid-cols-3 gap-3\">\n                   <div class=\"bg-white/5 border border-white/10 rounded-3xl p-4 text-center\">\n                    <span class=\"text-[8px] font-black text-slate-500 uppercase tracking-widest block mb-1\">Dist\303\242ncia</span>\n                    <strong class=\"text-sm font-black text-white\">{{ route.totalDistanceKm }} km</strong>\n                  </div>\n                  <div class=\"bg-white/5 border border-white/10 rounded-3xl p-4 text-center\">\n                    <span class=\"text-[8px] font-black text-slate-500 uppercase tracking-widest block mb-1\">Tempo Total</span>\n                    <strong class=\"text-sm font-black text-white\">{{ route.estimatedDuration }}</strong>\n                  </div>\n                  <div class=\"bg-white/5 border border-white/10 rounded-3xl p-4 text-center\">\n                    <span class=\"text-[8px] font-black text-purple-400 uppercase tracking-widest block mb-1\">Ganhos</span>\n                    <strong class=\"text-sm font-black text-purple-500\">R$ {{ route.totalEarnings.toFixed(2) }}</strong>\n                  </div>\n                </div>\n              </div>\n            } @else {\n              <div class=\"flex flex-col items-center justify-center py-20 text-center animate-in zoom-in duration-500\">\n                <div class=\"w-24 h-24 rounded-[2rem] bg-white/5 border border-white/10 flex items-center justify-center text-slate-700 mb-6 shadow-inner\">\n                  <mat-icon class=\"text-6xl\">sensors</mat-icon>\n                </div>\n                <h3 class=\"text-lg font-black text-white uppercase tracking-tight mb-2\">Nenhuma rota ativa</h3>\n                <p class=\"text-[10px] text-slate-500 uppercase tracking-widest max-w-xs mx-auto mb-8 leading-relaxed\">\n                  Consulte a aba de rotas dispon\303\255veis para aceitar uma nova corrida na regi\303\243o.\n                </p>\n                <button (click)=\"activeTab.set(\'available_routes\')\" class=\"px-8 py-4 bg-purple-600 hover:bg-purple-500 text-white font-black text-xs uppercase tracking-[0.2em] rounded-2xl shadow-[0_10px_30px_rgba(168,85,247,0.3)] transition-all active:scale-95 cursor-pointer\">\n                  Ver Rotas Dispon\303\255veis\n... (truncated)\n```\n\n--- /src/app/components/waiter-app.ts ---\n```typescript\nimport { ChangeDetectionStrategy, Component, inject, signal, computed } from \'@angular/core\';\nimport { CommonModule } from \'@angular/common\';\nimport { MatIconModule } from \'@angular/material/icon\';\nimport { Router } from \'@angular/router\';\nimport { EcosystemService } from \'../services/ecosystem.service\';\nimport { ProductItem, TableInfo } from \'../models/ecosystem.model\';\n\nexport type WaiterTab = \'mesas\' | \'comanda\' | \'kds_status\' | \'pareamento\';\n\ninterface ComandaItemDraft {\n  product: ProductItem;\n  quantity: number;\n  notes?: string;\n  course: \'entrada\' | \'principal\' | \'sobremesa\';\n}\n\n@Component({\n  changeDetection: ChangeDetectionStrategy.OnPush,\n  selector: \'app-waiter-app\',\n  standalone: true,\n  imports: [CommonModule, MatIconModule],\n  template: `\n    <div class=\"min-h-screen bg-[#0e0703] text-stone-100 font-sans selection:bg-amber-600 selection:text-white relative overflow-hidden flex flex-col justify-between\">\n      \n      <!-- SUBTLE RADIAL AMBIENT GLOW -->\n      <div class=\"absolute -top-24 -left-24 w-80 h-80 bg-amber-600/15 blur-[100px] rounded-full pointer-events-none\"></div>\n      <div class=\"absolute -bottom-24 -right-24 w-80 h-80 bg-orange-600/10 blur-[100px] rounded-full pointer-events-none\"></div>\n\n      <!-- MAIN SMARTPHONE PORTRAIT SHELL -->\n      <div class=\"w-full max-w-md mx-auto min-h-screen flex flex-col relative z-10 shadow-2xl border-x border-[#381c0c]/40 bg-[#0e0703]\">\n        \n        <!-- TOP NATIVE MOBILE STATUS BAR -->\n        <div class=\"px-5 pt-3 pb-1 flex justify-between items-center text-[10px] font-mono font-bold text-stone-400 bg-black/30 backdrop-blur-sm shrink-0\">\n          <span>{{ currentTime() }}</span>\n          <div class=\"flex items-center gap-1.5 text-stone-300\">\n            <span class=\"text-amber-400 font-bold\">WI-FI SAL\303\203O</span>\n            <mat-icon class=\"text-[12px] w-3 h-3 text-emerald-400\">wifi</mat-icon>\n            <div class=\"flex items-center text-[9px] gap-0.5\">\n              <mat-icon class=\"text-[12px] w-3 h-3 text-emerald-400\">battery_full</mat-icon>\n              <span>94%</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- APP HEADER WITH RESTAURANT & SERVER BADGE -->\n        <div class=\"px-5 py-3 border-b border-[#381c0c] bg-[#1a0c05] shrink-0\">\n          <div class=\"flex items-center justify-between\">\n            <div class=\"flex items-center gap-2.5\">\n              <div class=\"w-9 h-9 rounded-xl bg-gradient-to-br from-amber-500 to-amber-700 text-stone-950 flex items-center justify-center font-bold shadow-md\">\n                <mat-icon class=\"text-lg\">table_bar</mat-icon>\n              </div>\n              <div>\n                <h1 class=\"text-sm font-serif font-black tracking-tight text-white flex items-center gap-1.5\">\n                  <span>3EAT</span>\n                  <span class=\"text-amber-400 italic\">Gar\303\247om</span>\n                  <span class=\"text-[9px] font-mono bg-amber-950 text-amber-300 px-1.5 py-0.2 rounded border border-amber-700/50\">COMANDA</span>\n                </h1>\n                <p class=\"text-[10px] text-stone-400 font-mono\">\n                  {{ ecosystem.currentTenant().name }} \342\200\242 Gar\303\247om: <strong class=\"text-white\">{{ serverName() }}</strong>\n                </p>\n              </div>\n            </div>\n\n            <button\n              type=\"button\"\n              (click)=\"goToDesktopTables()\"\n              class=\"p-2 rounded-xl bg-[#2a1307] border border-[#482814] text-amber-300 hover:text-white transition-all cursor-pointer\"\n              title=\"Acessar Terminal Desktop\">\n              <mat-icon class=\"text-base\">desktop_windows</mat-icon>\n            </button>\n          </div>\n        </div>\n\n        <!-- SCROLLABLE BODY VIEWPORT -->\n        <div class=\"flex-1 overflow-y-auto px-4 py-4 space-y-4 custom-scrollbar pb-24\">\n\n          <!-- TAB 1: SELETOR DE MESAS DO SAL\303\203O -->\n          @if (activeTab() === \'mesas\') {\n            <div class=\"space-y-4 animate-in fade-in duration-300\">\n              \n              <!-- TOP SECTION TITLE & STATS -->\n              <div class=\"flex justify-between items-center bg-[#1d0e06] border border-[#482814] p-3 rounded-2xl\">\n                <div>\n                  <h3 class=\"font-serif font-black text-xs text-white uppercase tracking-wider flex items-center gap-1.5\">\n                    <mat-icon class=\"text-amber-500 text-sm\">room_service</mat-icon>\n                    <span>Sal\303\243o de Atendimento</span>\n                  </h3>\n                  <p class=\"text-[10px] text-stone-400\">Toque na mesa para abrir comanda ou lan\303\247ar pratos.</p>\n                </div>\n                <span class=\"text-[10px] font-mono bg-emerald-950 text-emerald-300 px-2 py-0.5 rounded border border-emerald-700/50 font-bold\">\n                  {{ freeTablesCount() }} Livres\n                </span>\n              </div>\n\n              <!-- TABLE GRID CARDS -->\n              <div class=\"grid grid-cols-2 gap-3\">\n                @for (table of ecosystem.tables(); track table.id) {\n                  <button\n                    type=\"button\"\n                    (click)=\"selectTable(table)\"\n                    [class]=\"selectedTable()?.id === table.id ? \'border-amber-500 ring-2 ring-amber-500/30\' : \'border-[#381c0c]\'\"\n                    class=\"bg-[#190c05] border hover:border-amber-600/70 p-3.5 rounded-2xl text-left transition-all cursor-pointer relative overflow-hidden group shadow-lg flex flex-col justify-between h-32\">\n                    \n                    <div class=\"flex justify-between items-start\">\n                      <span class=\"w-8 h-8 rounded-xl bg-[#2a1408] border border-[#482814] text-amber-300 font-serif font-black text-base flex items-center justify-center\">\n                        {{ table.number }}\n                      </span>\n\n                      <span\n                        [class]=\"table.status === \'available\' ? \'bg-emerald-950/80 text-emerald-300 border-emerald-700/60\' : table.status === \'billing\' ? \'bg-amber-950/80 text-amber-300 border-amber-700/60\' : \'bg-rose-950/80 text-rose-300 border-rose-700/60\'\"\n                        class=\"text-[9px] font-mono font-bold px-2 py-0.5 rounded-full border uppercase\">\n                        {{ table.status === \'available\' ? \'Livre\' : table.status === \'billing\' ? \'Conta\' : \'Ocupada\' }}\n                      </span>\n                    </div>\n\n                    <div class=\"space-y-0.5\">\n                      <div class=\"text-[11px] font-bold text-white truncate\">\n                        {{ table.status === \'available\' ? \'Mesa Dispon\303\255vel\' : (table.server || \'Gar\303\247om Lucas\') }}\n                      </div>\n                      <div class=\"text-[10px] font-mono text-stone-400 flex items-center justify-between\">\n                        <span>{{ table.guests || table.capacity }} Lugares</span>\n                        @if (table.currentTotal) {\n                          <strong class=\"text-amber-400\">R$ {{ table.currentTotal.toFixed(2) }}</strong>\n                        }\n                      </div>\n                    </div>\n                  </button>\n                }\n              </div>\n\n            </div>\n          }\n\n          <!-- TAB 2: LAN\303\207AMENTO DE COMANDA DA MESA ATIVA -->\n          @if (activeTab() === \'comanda\') {\n            <div class=\"space-y-4 animate-in fade-in duration-300\">\n              \n              <!-- ACTIVE TABLE BANNER -->\n              @if (selectedTable(); as table) {\n                <div class=\"bg-gradient-to-r from-[#2a1408] via-[#33180a] to-[#200e05] border-2 border-amber-600/60 rounded-2xl p-4 shadow-xl flex justify-between items-center\">\n                  <div>\n                    <div class=\"flex items-center gap-2\">\n                      <span class=\"w-7 h-7 rounded-lg bg-amber-500 text-stone-950 font-serif font-black text-xs flex items-center justify-center\">\n                        {{ table.number }}\n                      </span>\n                      <h3 class=\"font-serif font-black text-sm text-white\">Comanda Mesa {{ table.number }}</h3>\n                    </div>\n                    <p class=\"text-[10px] text-stone-300 font-mono mt-0.5\">\n                      {{ table.zone || \'Sal\303\243o Principal\' }} \342\200\242 Gar\303\247om: {{ serverName() }}\n                    </p>\n                  </div>\n\n                  <div class=\"text-right\">\n                    <span class=\"text-[9px] font-mono uppercase text-stone-400 block\">Total Itens</span>\n                    <strong class=\"text-amber-400 font-mono text-base font-black\">\n                      R$ {{ activeComandaTotal().toFixed(2) }}\n                    </strong>\n                  </div>\n                </div>\n              } @else {\n                <div class=\"p-6 bg-[#180b04] border border-[#381c0c] rounded-2xl text-center space-y-2\">\n                  <mat-icon class=\"text-4xl text-amber-500/40\">table_restaurant</mat-icon>\n                  <p class=\"text-xs font-bold text-white\">Nenhuma mesa selecionada</p>\n                  <p class=\"text-[10px] text-stone-400\">Escolha uma mesa no sal\303\243o para come\303\247ar a lan\303\247ar os pedidos.</p>\n                  <button (click)=\"activeTab.set(\'mesas\')\" class=\"px-4 py-2 bg-amber-600 text-stone-950 font-bold rounded-xl text-xs uppercase cursor-pointer\">\n                    Selecionar Mesa\n                  </button>\n                </div>\n              }\n\n              <!-- PRODUCT CATEGORY HORIZONTAL PILLS -->\n              @if (selectedTable()) {\n                <div class=\"flex gap-1.5 overflow-x-auto no-scrollbar pb-1\">\n                  @for (cat of productCategories; track cat.id) {\n                    <button\n                      type=\"button\"\n                      (click)=\"selectedCategory.set(cat.id)\"\n                      [class]=\"selectedCategory() === cat.id ? \'bg-amber-600 text-stone-950 font-black shadow\' : \'bg-[#1e0f07] text-stone-300 border border-[#482814]\'\"\n                      class=\"px-3 py-1.5 rounded-xl text-xs flex items-center gap-1.5 shrink-0 transition-all cursor-pointer font-bold\">\n                      <mat-icon class=\"text-xs\">{{ cat.icon }}</mat-icon>\n                      <span>{{ cat.label }}</span>\n                    </button>\n                  }\n                </div>\n\n                <!-- CADENCE / TEMPO SELECTOR -->\n                <div class=\"bg-[#1a0c05] p-2.5 rounded-2xl border border-[#381c0c] space-y-1.5\">\n                  <span class=\"text-[9px] font-mono uppercase text-amber-400 font-bold block\">Cad\303\252ncia de Sa\303\255da da Cozinha:</span>\n                  <div class=\"grid grid-cols-3 gap-1.5\">\n                    <button\n                      type=\"button\"\n                      (click)=\"selectedCourse.set(\'entrada\')\"\n                      [class]=\"selectedCourse() === \'entrada\' ? \'bg-amber-600 text-stone-950 font-black\' : \'bg-[#261207] text-stone-400\'\"\n                      class=\"py-1.5 rounded-lg text-[10px] font-bold uppercase transition-all\">\n                      1\302\272 Entrada\n                    </button>\n                    <button\n                      type=\"button\"\n                      (click)=\"selectedCourse.set(\'principal\')\"\n                      [class]=\"selectedCourse() === \'principal\' ? \'bg-amber-600 text-stone-950 font-black\' : \'bg-[#261207] text-stone-400\'\"\n... (truncated)\n```\n\n--- /src/index.html ---\n```html\n<!doctype html>\n<html lang=\"pt-BR\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <title>3EATCRU - ERP & POS Ecosystem</title>\n    <base href=\"/\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <meta name=\"description\" content=\"Multi-sphere Gastronomic Ecosystem: Dedicated Command Center for the App Owner, Enterprise OS for Store Merchants, and Public Marketplace for Consumers.\" />\n    <meta property=\"og:title\" content=\"3EATCRU - ERP & POS Ecosystem\" />\n    <meta property=\"og:description\" content=\"Multi-sphere Gastronomic Ecosystem: Dedicated Command Center for the App Owner, Enterprise OS for Store Merchants, and Public Marketplace for Consumers.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:site_name\" content=\"3EATCRU OS\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"3EATCRU - ERP & POS Ecosystem\" />\n    <meta name=\"twitter:description\" content=\"Multi-sphere Gastronomic Ecosystem: Dedicated Command Center for the App Owner, Enterprise OS for Store Merchants, and Public Marketplace for Consumers.\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;700&family=Syne:wght@700;800&family=Material+Icons&display=swap\" rel=\"stylesheet\">\n    <link rel=\"icon\" type=\"image/x-icon\" href=\"favicon.ico\" />\n    <script type=\"application/ld+json\">\n    {\n      \"@context\": \"https://schema.org\",\n      \"@type\": \"WebApplication\",\n      \"name\": \"3EATCRU OS\",\n      \"applicationCategory\": \"BusinessApplication\",\n      \"operatingSystem\": \"All\",\n      \"description\": \"Sistema Operacional Gastron\303\264mico completo com PDV Frente de Caixa, KDS Cozinha, Sal\303\243o de Mesas, Estoque NFe, Tesouraria DRE, iFood e WhatsApp CRM.\",\n      \"offers\": {\n        \"@type\": \"Offer\",\n        \"price\": \"0\",\n        \"priceCurrency\": \"BRL\"\n      }\n    }\n    </script>\n  </head>\n  <body>\n    <app-root></app-root>\n  </body>\n</html>\n\n\n```\n\n--- /src/styles.css ---\n```css\n@import url(\'https://fonts.googleapis.com/icon?family=Material+Icons\');\n@import url(\'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\');\n@import \"tailwindcss\";\n\n:root {\n  --bg: #0c0c0e;\n  --ink: #edeeef;\n  --accent: #f59e0b;\n  --surface: #161618;\n  --border: rgba(237, 238, 239, 0.1);\n  --ink-faint: rgba(237, 238, 239, 0.5);\n  font-family: \'Geist\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n}\n\nbody {\n  background-color: var(--bg);\n  color: var(--ink);\n  font-family: \'Geist\', sans-serif;\n  height: 100vh;\n  margin: 0;\n  padding: 0;\n  overflow: hidden;\n  -webkit-font-smoothing: antialiased;\n  background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.03) 1px, transparent 0);\n  background-size: 32px 32px;\n}\n\n.font-mono {\n  font-family: \'Geist Mono\', monospace;\n}\n\n.font-syne {\n  font-family: \'Syne\', sans-serif;\n  font-weight: 800;\n}\n\n.bg-dot-grid {\n  background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.03) 1px, transparent 0);\n  background-size: 32px 32px;\n}\n\n.no-scrollbar::-webkit-scrollbar {\n  display: none;\n}\n.no-scrollbar {\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n.custom-scrollbar::-webkit-scrollbar {\n  width: 4px;\n  height: 4px;\n}\n.custom-scrollbar::-webkit-scrollbar-track {\n  background: transparent;\n}\n.custom-scrollbar::-webkit-scrollbar-thumb {\n  background: rgba(237, 238, 239, 0.15);\n  border-radius: 4px;\n}\n.custom-scrollbar:hover::-webkit-scrollbar-thumb {\n  background: rgba(245, 158, 11, 0.4);\n}\n\n\n```\n\n--- /tsconfig.json ---\n```json\n/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */\n/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */\n{\n  \"compileOnSave\": false,\n  \"compilerOptions\": {\n    \"strict\": true,\n    \"noImplicitOverride\": true,\n    \"noPropertyAccessFromIndexSignature\": true,\n    \"noImplicitReturns\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"skipLibCheck\": true,\n    \"isolatedModules\": true,\n    \"experimentalDecorators\": true,\n    \"importHelpers\": true,\n    \"target\": \"ES2022\",\n    \"module\": \"preserve\",\n    \"resolveJsonModule\": true\n  },\n  \"angularCompilerOptions\": {\n    \"enableI18nLegacyMessageIdFormat\": false,\n    \"strictInjectionParameters\": true,\n    \"strictInputAccessModifiers\": true,\n    \"strictTemplates\": true\n  },\n  \"files\": [],\n  \"references\": [\n    {\n      \"path\": \"./tsconfig.app.json\"\n    },\n    {\n      \"path\": \"./tsconfig.spec.json\"\n    }\n  ]\n}\n\n```"

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Core Primitives & Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'madeinfavela89@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isTenantOwner(tenantId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.contactEmail == request.auth.token.email;
    }

    // 2. Validation Helpers
    function isValidTenant(data) {
      return data.keys().hasAll(['id', 'name', 'cnpj', 'plan', 'status', 'contactEmail']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.cnpj is string && data.cnpj.size() <= 20 &&
             data.plan in ['Starter', 'Professional', 'Enterprise'] &&
             data.status in ['active', 'suspended', 'trial'] &&
             data.contactEmail is string && data.contactEmail.size() <= 128;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'tenantId', 'name', 'price', 'stock']) &&
             data.id is string && data.id.size() <= 64 &&
             data.tenantId is string && data.tenantId.size() <= 64 &&
             data.name is string && data.name.size() <= 120 &&
             data.price is number && data.price >= 0 &&
             data.stock is number;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'tenantId', 'orderNumber', 'type', 'total', 'status', 'paymentMethod']) &&
             data.id is string && data.id.size() <= 64 &&
             data.tenantId is string && data.tenantId.size() <= 64 &&
             data.orderNumber is string && data.orderNumber.size() <= 32 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'preparing', 'ready', 'dispatched', 'completed', 'cancelled', 'delivered'] &&
             data.paymentMethod in ['cash', 'card', 'pix', 'online'];
    }

    function isValidRoute(data) {
      return data.keys().hasAll(['id', 'routeCode', 'status', 'totalDistanceKm', 'totalEarnings']) &&
             data.id is string && data.id.size() <= 64 &&
             data.routeCode is string && data.routeCode.size() <= 32 &&
             data.status in ['available', 'accepted', 'at_store', 'in_progress', 'completed'] &&
             data.totalDistanceKm is number &&
             data.totalEarnings is number;
    }

    // 3. Admin Security Gate
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isBootstrappedAdmin() && isValidId(adminId);
    }

    // 4. HQ Platform Global Settings
    match /hq_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }

    // 5. Tenant Store Enterprises (OS Sphere)
    match /tenants/{tenantId} {
      allow read: if true; // Public access for Marketplace & Storefront discovery
      allow create: if isAdmin() && isValidId(tenantId) && isValidTenant(incoming());
      allow delete: if isAdmin() && isValidId(tenantId);
      allow update: if isValidId(tenantId) && isValidTenant(incoming()) && (
        isAdmin() ||
        (isTenantOwner(tenantId) &&
         incoming().serviceFeePercent == existing().serviceFeePercent &&
         incoming().cnpj == existing().cnpj &&
         incoming().id == existing().id)
      );

      // Subcollection: Products / Inventory
      match /products/{productId} {
        allow read: if true;
        allow create: if isValidId(productId) && isValidProduct(incoming()) && 
                         incoming().tenantId == tenantId && (isAdmin() || isTenantOwner(tenantId));
        allow update: if isValidId(productId) && isValidProduct(incoming()) &&
                         incoming().id == existing().id &&
                         incoming().tenantId == existing().tenantId &&
                         (isAdmin() || isTenantOwner(tenantId));
        allow delete: if isValidId(productId) && (isAdmin() || isTenantOwner(tenantId));
      }

      // Subcollection: Orders
      match /orders/{orderId} {
        allow read: if isAdmin() || isTenantOwner(tenantId);
        allow create: if isValidId(orderId) && isValidOrder(incoming()) &&
                         incoming().tenantId == tenantId &&
                         incoming().status == 'pending';
        allow update: if isValidId(orderId) && isValidOrder(incoming()) && (
          isAdmin() ||
          (isTenantOwner(tenantId) && incoming().tenantId == existing().tenantId)
        );
        allow delete: if isAdmin() && isValidId(orderId);
      }
    }

    // 6. HQ Pro Dispatcher & Delivery Routes
    match /delivery_routes/{routeId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() && isValidId(routeId) && isValidRoute(incoming());
      allow update: if isValidId(routeId) && isValidRoute(incoming()) && (
        isAdmin() ||
        (isSignedIn() && (
          (existing().driverId == null && incoming().driverId == request.auth.uid) ||
          (existing().driverId == request.auth.uid)
        ))
      );
    }

    // 7. Drivers Telemetry & Compliance
    match /drivers/{driverId} {
      allow read: if isSignedIn();
      allow create: if isValidId(driverId) && (isAdmin() || (isSignedIn() && request.auth.uid == driverId));
      allow update: if isValidId(driverId) && (
        isAdmin() ||
        (isSignedIn() && request.auth.uid == driverId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'activeDeliveriesCount', 'currentLocationName', 'batteryLevel', 'lastGpsPing']))
      );
      allow delete: if isAdmin() && isValidId(driverId);
    }
  }
}
